Package: EXCISE
Type: Package
Title: X-Chromosome Inactivation Calling from Single-Cell RNA-seq
Version: 0.99.0
Authors@R: c(
    person("Zihan", "Zhuang", email = "zhuangzihan2021@hotmail.com",
